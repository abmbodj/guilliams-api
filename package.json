{
  "name": "guilliams-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 TypeScript mobile API with OpenAPI contracts and SQLite persistence",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests-ts/*.test.ts",
    "check": "npm run typecheck && npm run format:check && npm test && npm run verify:contract",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "verify:contract": "tsx scripts/verify-contract.ts",
    "generate:types": "openapi-typescript src/openapi-source.json -o src/generated/api-types.ts",
    "smoke": "node examples/smoke.mjs",
    "format": "prettier --write src tests-ts scripts/*.ts scripts/*.mjs",
    "format:check": "prettier --check src tests-ts scripts/*.ts scripts/*.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
